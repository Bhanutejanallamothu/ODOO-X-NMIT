# Server Port configuration
PORT=5000

# JSON Web Token Secret (used for signing and encrypting authorization tokens)
JWT_SECRET=dayflow_super_secret_jwt_key_987654321

# PostgreSQL database connection string
# Format: postgresql://[user[:password]@]host[:port][/database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dayflow

# SMTP Mail Server Configuration (Optional)
# If left empty, verification links will print directly to the server terminal console.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Example Configurations for SMTP:
# Ethereal Sandbox:
#   SMTP_HOST=smtp.ethereal.email
#   SMTP_PORT=587
#   SMTP_USER=your_generated_ethereal_username
#   SMTP_PASS=your_generated_ethereal_password
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_16_digit_google_app_password
